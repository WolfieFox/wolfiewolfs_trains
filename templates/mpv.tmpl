{{ $zoom := parseint .globals.zoom }}


{{- $layout := slice .layout -}}
{{- $newsprites := slice .new_sprites -}}
{{- $animated := slice .animated -}}
{{- $manual_ttd_len := .manual_ttd_len -}}
{{- $man_ttd_len := slice .manual_ttd_len -}}
{{- $len := .ttd_len -}}{{- $plen := parseint .ttd_len -}}{{- $bpp := .globals.bpp -}}
{{$speed := parseint .speed -}}
{{ $has_cargo_switch := "" -}}

//MPV Cargo sprites
{{ $cargo_list := "" -}}
{{if eq .cargo_handling "Container" -}}
    // Containers...
    {{ $cargo_list = "container_1,container_2,tank_container_1,tank_container_2,wood" -}}
{{end}}

spriteset(spriteset_{{.id}}_purchase, ZOOM_LEVEL_IN_4X, BIT_DEPTH_8BPP, "4x/{{.id}}_purchase.png")
{ template_purchase_4x() }

{{$lastindex := 0}}
{{range $index, $element := $layout -}}
    {{$lastindex = $index}}
{{end}}

{{- range $index, $element := $layout -}}
{{- $newsprite := index $newsprites $index -}}
{{- if eq $newsprite "1" -}}
{{if $manual_ttd_len }}{{$len = index $man_ttd_len $index }}{{end}}

{{$template := concat "template_auto_" $len -}}
{{if eq $bpp "32"}}{{ altsprites $element $template $zoom }}{{else}}{{ altsprites8 $element $template $zoom }}{{end}}

{{$template_turn := concat "template_auto_turn_1_" $len -}}
{{if eq $bpp "32"}}{{ altspritesn $element $template_turn $zoom "_turn_1" }}{{else}}{{ altsprites8n $element $template_turn $zoom "_turn_1" }}{{end}}

{{$template_turn = concat "template_auto_turn_2_" $len -}}
{{if eq $bpp "32"}}{{ altspritesn $element $template_turn $zoom "_turn_2" }}{{else}}{{ altsprites8n $element $template_turn $zoom "_turn_2" }}{{end}}

{{$template_turn = concat "template_auto_up_" $len -}}{{$hill := concat $element "_up" }}
{{if eq $bpp "32"}}{{ altsprites $hill $template_turn $zoom }}{{else}}{{ altsprites8 $hill $template_turn $zoom }}{{end}}

{{$template_turn = concat "template_auto_down_" $len -}}{{$hill = concat $element "_down" }}
{{if eq $bpp "32"}}{{ altsprites $hill $template_turn $zoom }}{{else}}{{ altsprites8 $hill $template_turn $zoom }}{{end}}

{{$plen = parseint $len}}
{{ if gt $plen 8}}
{{$sections := concat $element "_sections" -}}
{{$template_turn = concat "template_auto_front_" $len -}}
{{if eq $bpp "32"}}{{ altspritesn $sections $template_turn $zoom "_front" }}{{else}}{{ altsprites8n $sections $template_turn $zoom "_front" }}{{end}}
{{$template_turn = concat "template_auto_mid_" $len -}}
{{if eq $bpp "32"}}{{ altspritesn $sections $template_turn $zoom "_mid" }}{{else}}{{ altsprites8n $sections $template_turn $zoom "_mid" }}{{end}}
{{$template_turn = concat "template_auto_rear_" $len -}}
{{if eq $bpp "32"}}{{ altspritesn $sections $template_turn $zoom "_rear" }}{{else}}{{ altsprites8n $sections $template_turn $zoom "_rear" }}{{end}}
{{end}}


// Cargo Sprites
{{$template_turn_1 := concat "template_auto_" $len -}}
{{$template_turn_2 := concat "template_auto_" $len -}}
{{$template_up := concat "template_auto_up_" $len -}}
{{$template_down := concat "template_auto_down_" $len -}}

{{ if $cargo_list}}
    {{$fullid := concat $element "_none"}}{{ altsprites8 $fullid $template $zoom }}
    {{ altsprites8n $fullid $template_turn_1 $zoom "_turn_1" }}

    {{ altsprites8n $fullid $template_turn_2 $zoom "_turn_2" }}
    {{$hill := concat $fullid "_up"}}{{ altsprites8 $hill $template_up $zoom }}
    {{$hill = concat $fullid "_down"}}{{ altsprites8 $hill $template_down $zoom }}

    {{if gt $plen 8}}
        {{$sections := concat $fullid "_sections" -}}
        {{$template_turn := concat "template_auto_front_" $len -}}
        {{ altsprites8n $sections $template_turn $zoom "_front" }}
        {{$template_turn = concat "template_auto_mid_" $len -}}
        {{ altsprites8n $sections $template_turn $zoom "_mid" }}
        {{$template_turn = concat "template_auto_rear_" $len -}}
        {{ altsprites8n $sections $template_turn $zoom "_rear" }}
    {{end}}
{{end}}

{{if or (eq $index 0) (eq $index $lastindex)}}
    {{ $template := concat "template_auto_" $len -}}
    {{ $template = concat $template "_anim" -}}
    {{ $hlt_on_f := concat $element "_hlt_on_front" }}{{ altsprites8 $hlt_on_f $template $zoom }}
    {{ $tlt_on_f := concat $element "_tlt_on_front" }}{{ altsprites8 $tlt_on_f $template $zoom }}
    {{ $hlt_on_r := concat $element "_hlt_on_rear" }}{{ altsprites8 $hlt_on_r $template $zoom }}
    {{ $tlt_on_r := concat $element "_tlt_on_rear" }}{{ altsprites8 $tlt_on_r $template $zoom }}

    {{$template_turn = concat "template_auto_turn_1_" $len -}}
    {{ $template_turn = concat $template_turn "_anim" -}}
    {{ altsprites8n $hlt_on_f $template_turn $zoom "_turn_1" }}{{ altsprites8n $tlt_on_f $template_turn $zoom "_turn_1" }}
    {{ altsprites8n $hlt_on_r $template_turn $zoom "_turn_1" }}{{ altsprites8n $tlt_on_r $template_turn $zoom "_turn_1" }}
    {{$template_turn = concat "template_auto_turn_2_" $len -}}
    {{ $template_turn = concat $template_turn "_anim" -}}
    {{ altsprites8n $hlt_on_f $template_turn $zoom "_turn_2" }}{{ altsprites8n $tlt_on_f $template_turn $zoom "_turn_2" }}
    {{ altsprites8n $hlt_on_r $template_turn $zoom "_turn_2" }}{{ altsprites8n $tlt_on_r $template_turn $zoom "_turn_2" }}

    {{$template_turn = concat "template_auto_up_" $len -}}
    {{$template_turn = concat $template_turn "_anim" -}}
    {{$hill = concat $hlt_on_f "_up" }}{{ altsprites8 $hill $template_turn $zoom }}
    {{$hill = concat $tlt_on_f "_up" }}{{ altsprites8 $hill $template_turn $zoom }}
    {{$hill = concat $hlt_on_r "_up" }}{{ altsprites8 $hill $template_turn $zoom }}
    {{$hill = concat $tlt_on_r "_up" }}{{ altsprites8 $hill $template_turn $zoom }}

    {{$template_turn = concat "template_auto_down_" $len -}}
    {{$template_turn = concat $template_turn "_anim" -}}
    {{$hill = concat $hlt_on_f "_down" }}{{ altsprites8 $hill $template_turn $zoom }}
    {{$hill = concat $tlt_on_f "_down" }}{{ altsprites8 $hill $template_turn $zoom }}
    {{$hill = concat $hlt_on_r "_down" }}{{ altsprites8 $hill $template_turn $zoom }}
    {{$hill = concat $tlt_on_r "_down" }}{{ altsprites8 $hill $template_turn $zoom }}

    {{ if gt $plen 8}}
        {{$sections := concat $hlt_on_f "_sections" -}}
        {{$template_turn = concat "template_auto_front_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_front" }}
        {{$template_turn = concat "template_auto_mid_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_mid" }}
        {{$template_turn = concat "template_auto_rear_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_rear" }}

        {{$sections = concat $tlt_on_f "_sections" -}}
        {{$template_turn = concat "template_auto_front_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_front" }}
        {{$template_turn = concat "template_auto_mid_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_mid" }}
        {{$template_turn = concat "template_auto_rear_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_rear" }}

        {{$sections = concat $hlt_on_r "_sections" -}}
        {{$template_turn = concat "template_auto_front_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_front" }}
        {{$template_turn = concat "template_auto_mid_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_mid" }}
        {{$template_turn = concat "template_auto_rear_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_rear" }}

        {{$sections = concat $tlt_on_r "_sections" -}}
        {{$template_turn = concat "template_auto_front_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_front" }}
        {{$template_turn = concat "template_auto_mid_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_mid" }}
        {{$template_turn = concat "template_auto_rear_" $len -}}{{$template_turn = concat $template_turn "_anim"}}{{ altsprites8n $sections $template_turn $zoom "_rear" }}
    {{end}}
{{end}}


{{ range $index, $cargoelement := slice $cargo_list -}}{{ if $cargoelement -}}
    // Cargo: {{$cargoelement}}
    // cargo sprites are always 8 bit
    {{$elus := concat "_" $cargoelement}}{{ range $idx2, $el2 := slice "_half,_full" }}
        {{$cargo := concat $elus $el2  }}
        {{$fullid := concat $element $cargo}}{{ altsprites8 $fullid $template $zoom }}
        {{ altsprites8n $fullid $template_turn_1 $zoom "_turn_1" }}
        {{ altsprites8n $fullid $template_turn_2 $zoom "_turn_2" }}
        {{$hill := concat $fullid "_up"}}{{ altsprites8 $hill $template_up $zoom }}
        {{$hill = concat $fullid "_down"}}{{ altsprites8 $hill $template_down $zoom }}


        {{if gt $plen 8}}
            {{$sections := concat $fullid "_sections" -}}
            {{$template_turn := concat "template_auto_front_" $len -}}
            {{ altsprites8n $sections $template_turn $zoom "_front" }}
            {{$template_turn = concat "template_auto_mid_" $len -}}
            {{ altsprites8n $sections $template_turn $zoom "_mid" }}
            {{$template_turn = concat "template_auto_rear_" $len -}}
            {{ altsprites8n $sections $template_turn $zoom "_rear" }}
        {{end}}

    {{end -}}
    {{$cargoid := concat $element $elus }}

    spritegroup spritegroup_{{$cargoid}} {
    loading: [spriteset_{{$element}}_none, spriteset_{{$element}}_{{$cargoelement}}_half, spriteset_{{$element}}_{{$cargoelement}}_half, spriteset_{{$element}}_{{$cargoelement}}_full ];
    loaded: [spriteset_{{$element}}_none, spriteset_{{$element}}_{{$cargoelement}}_half, spriteset_{{$element}}_{{$cargoelement}}_half, spriteset_{{$element}}_{{$cargoelement}}_full ];
    }

    spritegroup spritegroup_{{$cargoid}}_turn_1 {
    loading: [spriteset_{{$element}}_none_turn_1, spriteset_{{$element}}_{{$cargoelement}}_half_turn_1, spriteset_{{$element}}_{{$cargoelement}}_half_turn_1, spriteset_{{$element}}_{{$cargoelement}}_full_turn_1 ];
    loaded: [spriteset_{{$element}}_none_turn_1, spriteset_{{$element}}_{{$cargoelement}}_half_turn_1, spriteset_{{$element}}_{{$cargoelement}}_half_turn_1, spriteset_{{$element}}_{{$cargoelement}}_full_turn_1 ];
    }

    spritegroup spritegroup_{{$cargoid}}_turn_2 {
    loading: [spriteset_{{$element}}_none_turn_2,spriteset_{{$element}}_{{$cargoelement}}_half_turn_2, spriteset_{{$element}}_{{$cargoelement}}_half_turn_2, spriteset_{{$element}}_{{$cargoelement}}_full_turn_2 ];
    loaded: [spriteset_{{$element}}_none_turn_2,spriteset_{{$element}}_{{$cargoelement}}_half_turn_2, spriteset_{{$element}}_{{$cargoelement}}_half_turn_2, spriteset_{{$element}}_{{$cargoelement}}_full_turn_2 ];
    }

    spritegroup spritegroup_{{$cargoid}}_up {
    loading: [spriteset_{{$element}}_none_up,spriteset_{{$element}}_{{$cargoelement}}_half_up, spriteset_{{$element}}_{{$cargoelement}}_half_up, spriteset_{{$element}}_{{$cargoelement}}_full_up ];
    loaded: [spriteset_{{$element}}_none_up,spriteset_{{$element}}_{{$cargoelement}}_half_up, spriteset_{{$element}}_{{$cargoelement}}_half_up, spriteset_{{$element}}_{{$cargoelement}}_full_up ];
    }

    spritegroup spritegroup_{{$cargoid}}_down {
    loading: [spriteset_{{$element}}_none_down,spriteset_{{$element}}_{{$cargoelement}}_half_down, spriteset_{{$element}}_{{$cargoelement}}_half_down, spriteset_{{$element}}_{{$cargoelement}}_full_down ];
    loaded: [spriteset_{{$element}}_none_down,spriteset_{{$element}}_{{$cargoelement}}_half_down, spriteset_{{$element}}_{{$cargoelement}}_half_down, spriteset_{{$element}}_{{$cargoelement}}_full_down ];
    }
    {{if gt $plen 8}}
        // We don't have the same spritegroups for front/mid/rear as they are emulated using switches, to avoid different sections
        // of the vehicle having different loading states
        //
        // The only spritegroup for front/rear is the "empty" one, so we can reuse the "none" spriteset easily without having
        // to pass multiple variables to the cargo curve switch

        spritegroup spritegroup_{{$cargoid}}_none_sections_front {
        loading: [spriteset_{{$element}}_none_sections_front ];
        loaded: [spriteset_{{$element}}_none_sections_front ];
        }

        spritegroup spritegroup_{{$cargoid}}_sections_mid {
        loading: [spriteset_{{$element}}_none_sections_mid,spriteset_{{$element}}_{{$cargoelement}}_half_sections_mid, spriteset_{{$element}}_{{$cargoelement}}_half_sections_mid, spriteset_{{$element}}_{{$cargoelement}}_full_sections_mid ];
        loaded: [spriteset_{{$element}}_none_sections_mid,spriteset_{{$element}}_{{$cargoelement}}_half_sections_mid, spriteset_{{$element}}_{{$cargoelement}}_half_sections_mid, spriteset_{{$element}}_{{$cargoelement}}_full_sections_mid ];
        }

        spritegroup spritegroup_{{$cargoid}}_none_sections_rear {
        loading: [spriteset_{{$element}}_none_sections_rear ];
        loaded: [spriteset_{{$element}}_none_sections_rear ];
        }
    {{end}}

    {{if gt $plen 8}}{{template "cargo_curve_switch_long" $cargoid }}{{else if gt $plen 4 }}{{template "cargo_curve_switch_medium" $cargoid }}{{else}}{{template "cargo_curve_switch_short" $cargoid }}{{end}}
{{end -}}{{ end }}
// End cargo sprites

{{end -}}

{{end}}

{{- $type := .type }}{{$pantograph_unit := .pantograph_unit -}}{{- $id := .id}}
{{ if .pantograph_unit -}}{{template "pantograph_graphics" . }}{{end}}

// Articulation
switch(FEAT_TRAINS, SELF, switch_{{.id}}_articulation, extra_callback_info1) {
    0 .. ({{.cars}} * 3) - 1: {{.id}};
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
}

{{ if .manual_lengths }}
{{- $lengths := slice .manual_lengths }}
// This MU has different lengths per unit
switch (FEAT_TRAINS, SELF, switch_{{.id}}_length, position_in_articulated_veh % {{len $lengths}} ) 
{
    {{range $index, $element := $lengths -}}
    {{$index }}: return {{ $element }};
    {{end}}    
}
{{ else }}
// All parts of this MU are the same length
switch (FEAT_TRAINS, SELF, switch_{{.id}}_length, position_in_articulated_veh % 3 ) 
{
    {{range $index, $element := slice .articulated_lengths -}}
    {{$index }}: return {{ $element }};
    {{end}}    
}
{{end}}

{{range $index, $element := $layout -}}
{{- $newsprite := index $newsprites $index -}}
{{- if eq $newsprite "1" -}}
{{if $manual_ttd_len }}{{$len = index $man_ttd_len $index }}{{end}}{{$plen = parseint $len}}
{{if gt $plen 8}}{{template "curve_switch_long" $element }}{{else if gt $plen 4 }}{{template "curve_switch_medium" $element }}{{else}}{{template "curve_switch_short" $element }}{{end}}

{{end -}}
{{end -}}

{{- if .pantograph_unit -}}
{{template "pantograph_switch" . }}
{{end}}

{{range $index, $element := $layout -}}
    {{- $newsprite := index $newsprites $index -}}
    {{- if eq $newsprite "1" -}}
        {{if $manual_ttd_len }}{{$len = index $man_ttd_len $index }}{{end}}{{$plen = parseint $len}}
        {{ $sprite := $element}}
        {{ $basegraphics := concat $sprite "_curve" }}

        {{if or (eq $index 0) (eq $index $lastindex)}}
            {{ $name := concat $element "_hlt_on_front" }}
            {{if gt $plen 8}}{{template "curve_switch_long" $name }}{{else if gt $plen 4 }}{{template "curve_switch_medium" $name }}{{else}}{{template "curve_switch_short" $name }}{{end}}

            {{ $name = concat $element "_tlt_on_front" }}
            {{if gt $plen 8}}{{template "curve_switch_long" $name }}{{else if gt $plen 4 }}{{template "curve_switch_medium" $name }}{{else}}{{template "curve_switch_short" $name }}{{end}}

            {{ $name = concat $element "_hlt_on_rear" }}
            {{if gt $plen 8}}{{template "curve_switch_long" $name }}{{else if gt $plen 4 }}{{template "curve_switch_medium" $name }}{{else}}{{template "curve_switch_short" $name }}{{end}}

            {{ $name = concat $element "_tlt_on_rear" }}
            {{if gt $plen 8}}{{template "curve_switch_long" $name }}{{else if gt $plen 4 }}{{template "curve_switch_medium" $name }}{{else}}{{template "curve_switch_short" $name }}{{end}}

            {{$condition := "((vehicle_is_flipped ? position_in_consist_from_end : position_in_consist) < 3) ? (train_is_driving_backwards ? 2 : 1) : 0"}}

            switch (FEAT_TRAINS, SELF, switch_{{$element}}_front_light_state, {{$condition}})
            {
            1: switch_{{$element}}_hlt_on_front_curve;
            2: switch_{{$element}}_tlt_on_front_curve;
            spriteset_invisible;
            }

            {{if gt $plen 8}}
                switch (FEAT_TRAINS, SELF, switch_{{$element}}_front_light_state_front, {{$condition}})
                {
                1: switch_{{$element}}_hlt_on_front_curve_front;
                2: switch_{{$element}}_tlt_on_front_curve_front;
                spriteset_invisible;
                }

                switch (FEAT_TRAINS, SELF, switch_{{$element}}_front_light_state_rear, {{$condition}})
                {
                1: switch_{{$element}}_hlt_on_front_curve_rear;
                2: switch_{{$element}}_tlt_on_front_curve_rear;
                spriteset_invisible;
                }
            {{end}}

            {{$condition = "((vehicle_is_flipped ? position_in_consist : position_in_consist_from_end) < 3) ? (train_is_driving_backwards ? 1 : 2) : 0"}}

            switch (FEAT_TRAINS, SELF, switch_{{$element}}_rear_light_state, {{$condition}})
            {
            1: switch_{{$element}}_hlt_on_rear_curve;
            2: switch_{{$element}}_tlt_on_rear_curve;
            spriteset_invisible;
            }

            {{if gt $plen 8}}
                switch (FEAT_TRAINS, SELF, switch_{{$element}}_rear_light_state_front, {{$condition}})
                {
                1: switch_{{$element}}_hlt_on_rear_curve_front;
                2: switch_{{$element}}_tlt_on_rear_curve_front;
                spriteset_invisible;
                }

                switch (FEAT_TRAINS, SELF, switch_{{$element}}_rear_light_state_rear, {{$condition}})
                {
                1: switch_{{$element}}_hlt_on_rear_curve_rear;
                2: switch_{{$element}}_tlt_on_rear_curve_rear;
                spriteset_invisible;
                }
            {{end}}

            switch(FEAT_TRAINS, SELF, switch_{{$element}}_lights, getbits(extra_callback_info1, 8, 8)) {
            0: switch_{{$basegraphics}};
            1: switch_{{$element}}_front_light_state;
            2: switch_{{$element}}_rear_light_state;

            // This should never be executed
            return spriteset_invisible;
            }

            {{if gt $plen 8}}
                switch(FEAT_TRAINS, SELF, switch_{{$element}}_lights_front, getbits(extra_callback_info1, 8, 8)) {
                0: switch_{{$basegraphics}}_front;
                1: switch_{{$sprite}}_front_light_state_front;
                2: switch_{{$sprite}}_rear_light_state_front;

                // This should never be executed
                return spriteset_invisible;
                }

                switch(FEAT_TRAINS, SELF, switch_{{$element}}_lights_rear,getbits(extra_callback_info1, 8, 8)) {
                0: switch_{{$basegraphics}}_rear;
                1: switch_{{$sprite}}_front_light_state_rear;
                2: switch_{{$sprite}}_rear_light_state_rear;

                // This should never be executed
                return spriteset_invisible;
                }
            {{end}}
        {{end}}
    {{end}}
{{end -}}

{{ if eq .cargo_handling "Container" }}
    {{ $has_cargo_switch = "1" }}

{{- $containers := "container_1,container_2" -}}
{{- $tanktainers := "tank_container_1,tank_container_2" -}}
{{- $container_selector := "cargo_classes & bitmask(CC_EXPRESS, CC_COVERED_BULK, CC_LIQUID_BULK, CC_GAS_BULK, CC_PIECE_GOODS)"}}

    {{- range $index, $vehicle := $layout -}}
        {{- $newsprite := index $newsprites $index -}}
        {{- if eq $newsprite "1" -}}

        random_switch (FEAT_TRAINS, SELF, switch_{{$vehicle}}_containers)
        {
        {{range $index, $element := slice $containers -}}
            4: switch_{{$vehicle}}_{{$element}}_curve;
        {{end}}
        }

        random_switch (FEAT_TRAINS, SELF, switch_{{$vehicle}}_tank_containers)
        {
        {{range $index, $element := slice $tanktainers -}}
            4: switch_{{$vehicle}}_{{$element}}_curve;
        {{end}}
        }

        switch(FEAT_TRAINS, SELF, switch_{{$vehicle}}_container_type, {{$container_selector}})
        {
            bitmask(CC_EXPRESS): switch_{{$vehicle}}_containers;
            bitmask(CC_COVERED_BULK): switch_{{$vehicle}}_containers;
            bitmask(CC_LIQUID_BULK): switch_{{$vehicle}}_tank_containers;
            bitmask(CC_EXPRESS, CC_LIQUID_BULK): switch_{{$vehicle}}_tank_containers; // Tankers for beer...
            bitmask(CC_GAS_BULK): switch_{{$vehicle}}_tank_containers;
            bitmask(CC_EXPRESS, CC_GAS_BULK): switch_{{$vehicle}}_tank_containers; // Scary cargo.
            bitmask(CC_LIQUID_BULK, CC_GAS_BULK): switch_{{$vehicle}}_tank_containers;
            bitmask(CC_EXPRESS, CC_LIQUID_BULK, CC_GAS_BULK): switch_{{$vehicle}}_tank_containers;
            bitmask(CC_PIECE_GOODS): switch_{{$vehicle}}_wood_curve;

            switch_{{$vehicle}}_containers;
        }

        {{$basegraphics := concat $vehicle "_curve"}}
        {{$bgi := "0"}}
        {{$li := "1"}}
        {{ if or (eq $index 0) (eq $index $lastindex)}}
            {{$basegraphics = concat $vehicle "_lights"}}
            {{$bgi = "0..2"}}
            {{$li = "3"}}
        {{end -}}

        switch(FEAT_TRAINS, SELF, switch_{{$vehicle}}_cargo_container, [
        STORE_TEMP((getbits(extra_callback_info1, 8, 8) < {{$li}} ? CB_FLAG_MORE_SPRITES : 0) // Sprite Stack
            | (getbits(extra_callback_info1, 8, 8) != {{$li}} ? PALETTE_USE_DEFAULT : switch_container_random_colour()), 0x100), // Palette selection
        getbits(extra_callback_info1, 8, 8)
        ]) {
        {{$bgi}}: switch_{{$basegraphics}};
        {{$li}}: switch_{{$vehicle}}_container_type;

        // This should never be executed
        return spriteset_invisible;
        }

        {{ if gt $plen 8}}
            random_switch (FEAT_TRAINS, BACKWARD_SELF(1), switch_{{$vehicle}}_containers_front)
            {
            {{range $index, $element := slice $containers -}}
                4: switch_{{$vehicle}}_{{$element}}_curve_front;
            {{end}}
            }

            random_switch (FEAT_TRAINS, BACKWARD_SELF(1), switch_{{$vehicle}}_tank_containers_front)
            {
            {{range $index, $element := slice $tanktainers -}}
                4: switch_{{$vehicle}}_{{$element}}_curve_front;
            {{end}}
            }

            switch(FEAT_TRAINS, SELF, switch_{{$vehicle}}_container_type_front, {{$container_selector}})
            {
                bitmask(CC_EXPRESS): switch_{{$vehicle}}_containers_front;
                bitmask(CC_COVERED_BULK): switch_{{$vehicle}}_containers_front;
                bitmask(CC_LIQUID_BULK): switch_{{$vehicle}}_tank_containers_front;
                bitmask(CC_EXPRESS, CC_LIQUID_BULK): switch_{{$vehicle}}_tank_containers_front; // Tankers for beer...
                bitmask(CC_GAS_BULK): switch_{{$vehicle}}_tank_containers_front;
                bitmask(CC_EXPRESS, CC_GAS_BULK): switch_{{$vehicle}}_tank_containers_front; // Scary cargo.
                bitmask(CC_LIQUID_BULK, CC_GAS_BULK): switch_{{$vehicle}}_tank_containers_front;
                bitmask(CC_EXPRESS, CC_LIQUID_BULK, CC_GAS_BULK): switch_{{$vehicle}}_tank_containers_front;
                bitmask(CC_PIECE_GOODS): switch_{{$vehicle}}_wood_curve_front;

                switch_{{$vehicle}}_containers_front;
            }

            switch(FEAT_TRAINS, SELF, switch_{{$vehicle}}_cargo_container_front, [
                STORE_TEMP((getbits(extra_callback_info1, 8, 8) < {{$li}} ? CB_FLAG_MORE_SPRITES : 0) // Sprite Stack
                | (getbits(extra_callback_info1, 8, 8) != {{$li}} ? PALETTE_USE_DEFAULT : switch_container_random_colour_front()), 0x100), // Palette selection
            getbits(extra_callback_info1, 8, 8)
            ]) {
            {{$bgi}}: switch_{{$basegraphics}}_front;
            {{$li}}: switch_{{$vehicle}}_container_type_front;

            // This should never be executed
            return spriteset_invisible;
            }


            random_switch (FEAT_TRAINS, FORWARD_SELF(1), switch_{{$vehicle}}_containers_rear)
            {
            {{range $index, $element := slice $containers -}}
                4: switch_{{$vehicle}}_{{$element}}_curve_rear;
            {{end}}
            }

            random_switch (FEAT_TRAINS, FORWARD_SELF(1), switch_{{$vehicle}}_tank_containers_rear)
            {
            {{range $index, $element := slice $tanktainers -}}
                4: switch_{{$vehicle}}_{{$element}}_curve_rear;
            {{end}}
            }

            switch(FEAT_TRAINS, SELF, switch_{{$vehicle}}_container_type_rear, {{$container_selector}})
            {
                bitmask(CC_EXPRESS): switch_{{$vehicle}}_containers_rear;
                bitmask(CC_COVERED_BULK): switch_{{$vehicle}}_containers_rear;
                bitmask(CC_LIQUID_BULK): switch_{{$vehicle}}_tank_containers_rear;
                bitmask(CC_EXPRESS, CC_LIQUID_BULK): switch_{{$vehicle}}_tank_containers_rear; // Tankers for beer...
                bitmask(CC_GAS_BULK): switch_{{$vehicle}}_tank_containers_rear;
                bitmask(CC_EXPRESS, CC_GAS_BULK): switch_{{$vehicle}}_tank_containers_rear; // Scary cargo.
                bitmask(CC_LIQUID_BULK, CC_GAS_BULK): switch_{{$vehicle}}_tank_containers_rear;
                bitmask(CC_EXPRESS, CC_LIQUID_BULK, CC_GAS_BULK): switch_{{$vehicle}}_tank_containers_rear;
                bitmask(CC_PIECE_GOODS): switch_{{$vehicle}}_wood_curve_rear;

                switch_{{$vehicle}}_containers_rear;
            }

            switch(FEAT_TRAINS, SELF, switch_{{$vehicle}}_cargo_container_rear, [
                STORE_TEMP((getbits(extra_callback_info1, 8, 8) < {{$li}} ? CB_FLAG_MORE_SPRITES : 0) // Sprite Stack
                | (getbits(extra_callback_info1, 8, 8) != {{$li}} ? PALETTE_USE_DEFAULT : switch_container_random_colour_rear()), 0x100), // Palette selection
            getbits(extra_callback_info1, 8, 8)
            ]) {
            {{$bgi}}: switch_{{$basegraphics}}_rear;
            {{$li}}: switch_{{$vehicle}}_container_type_rear;

            // This should never be executed
            return spriteset_invisible;
            }
        {{- end }}
        {{ end }}
    {{end}}

    switch (FEAT_TRAINS, SELF, switch_{{.id}}_graphics, position_in_articulated_veh % ({{.cars}} * 3))
    {
    {{- range $index, $element := $layout -}}
    {{if $manual_ttd_len }}{{$len = index $man_ttd_len $index }}{{end}}{{$plen = parseint $len}}

    ({{$index}} * 3) + 1: switch_{{$element}}_cargo_container;
    {{- if gt $plen 8}}
    ({{$index}} * 3) + 0: switch_{{$element}}_cargo_container_front;
    ({{$index}} * 3) + 2: switch_{{$element}}_cargo_container_rear;
    {{ end -}}
    {{- end}}
    return spriteset_invisible;
    }
{{end}}

{{template "visual_effect_power" . }}
{{if not .use_mu_engine_logic}}{{template "attach_mu_switch" .}}{{end}}

item(FEAT_TRAINS, {{.id}}, {{.numeric_id}}) {
    property {
        name:                         {{.name_string}};
        climates_available:           {{ if .enable_param }} {{.enable_param}} ? {{end}} ALL_CLIMATES {{ if .enable_param }} : NO_CLIMATE {{end}};
        introduction_date:            date({{.year}}, {{.intro_month}}, 5);
        model_life:                   {{if .service}}{{.lifespan}};{{else}}VEHICLE_NEVER_EXPIRES;{{end}}
        retire_early:                 -4;
        vehicle_life:                 {{.vehicle_life}};

        {{if eq .default_cargo "PASS" }}
        refittable_cargo_classes: bitmask(CC_PASSENGERS);
        cargo_allow_refit: [ YETI, YETY ]; 
        {{ else if eq .default_cargo "MAIL" }}
        refittable_cargo_classes: bitmask(CC_MAIL);
        {{else if eq .cargo_handling "Container" }}
        refittable_cargo_classes: bitmask(CC_EXPRESS, CC_LIQUID_BULK, CC_GAS_BULK, CC_COVERED_BULK);
        cargo_allow_refit: [ WOOD ];
        {{end}}

        {{ if eq .type "steam" -}}
        engine_class:                 ENGINE_CLASS_STEAM;
        {{ else if eq .type "electric" -}}
        engine_class:                 ENGINE_CLASS_ELECTRIC;
        {{ else if eq .type "tube" -}}
        engine_class:                 ENGINE_CLASS_ELECTRIC;
        {{else -}}
        engine_class:                 ENGINE_CLASS_DIESEL;
        {{- end}}

        cargo_age_period:             ({{if .cargo_age_period -}}
            {{.cargo_age_period}}{{else}}185
        {{- end}} * cargo_age_multiplier) / 2;
        running_cost_base:            RUNNING_COST_DIESEL;
        tractive_effort_coefficient:  {{.te_coeff}};

        power:                        {{.power}} hp;
        speed:                        {{.speed}} mph;
        reliability_decay:            20;
        {{if .loading_speed}}loading_speed:                {{.loading_speed}};{{end}}
        cost_factor:                  {{.cost}};
        running_cost_factor:          {{.running_cost}};
        sprite_id:                    SPRITE_ID_NEW_TRAIN;
        misc_flags:                   bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_MU, TRAIN_FLAG_SPRITE_STACK);

        refit_cost:                   0;
        track_type:                   {{ if eq .type "dual_power" -}}RAIL{{else}}{{.railtype}}{{end}};
        dual_headed:                0;

        {{if lt $speed 50 -}}
        air_drag_coefficient:         0.1;
        {{- else -}}
        air_drag_coefficient:         7 / ({{.speed}} * 1.6);
        {{- end}}

        {{if .capacity}}
        cargo_capacity:               {{.capacity}} / 3;
        {{if ne .capacity "0"}}
        default_cargo_type:           {{.default_cargo}};
        {{end}}{{end}}
        weight:                       {{.weight}} ton;
        {{- if .variant_group}}
        variant_group:                {{.variant_group}};
        extra_flags:                  bitmask(VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
        {{- end}}

        {{if .badges}}
            badges: [
            {{- range $index, $element := slice .badges -}}
            {{if $element}}{{if $index}}, {{end}}"{{ $element }}"{{end}}{{end}}];
        {{end}}
    }

    graphics {
        default:  switch_{{.id}}_graphics;
        purchase:  spriteset_{{.id}}_purchase;
        additional_text: return {{.additional_text_string}};
        articulated_part: switch_{{.id}}_articulation;
        length: switch_{{.id}}_length;
{{template "running_cost_cb" . }}
        purchase_running_cost_factor: return {{.running_cost}};
        visual_effect_and_powered: switch_{{.id}}_visual_effect;
        {{- if .secondary_speed }}
        speed: switch_{{.id}}_speed; 
        {{ end -}}
        {{if .secondary_power}}{{ if eq .type "dual_power" -}}power: switch_{{.id}}_power;{{end}}{{ if eq .type "dual_electric" -}}power: switch_{{.id}}_power;{{end}}{{end}}
        {{if .capacity}}purchase_cargo_capacity:  {{if .reuse_sprites}}spriteset_{{.reuse_sprites}}{{else}}spriteset_{{.id}}{{end}};{{end}}
        cargo_capacity: return {{.capacity}} / 3;
        {{if not .use_mu_engine_logic}}can_attach_wagon: switch_{{.id}}_attach_wagons;{{end}}
        {{if .inhibit_lead}}start_stop: procedure_inhibit_lead;{{end}}
    }
}
