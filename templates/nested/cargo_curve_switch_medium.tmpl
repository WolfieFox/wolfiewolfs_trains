{{define "cargo_curve_switch_medium"}}
switch (FEAT_TRAINS, SELF, switch_{{.}}_height_fwd, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(-1) : 0) {
    -128..-1: return spritegroup_{{.}}_down;
    1..127: return spritegroup_{{.}}_up;
    return spritegroup_{{.}};
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_height_rev, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(1) : 0) {
    -128..-1: return spritegroup_{{.}}_up;
    1..127: return spritegroup_{{.}}_down;
    return spritegroup_{{.}};
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_height, vehicle_is_flipped)  {
    0: switch_{{.}}_height_fwd;
    1: switch_{{.}}_height_rev;
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve, getbits(extra_callback_info1, 0, 8) == 0 ? curv_info : 0)  {
    vehicle_curv_info(1, 0): return spritegroup_{{.}}_turn_1;
    vehicle_curv_info(0, 1): return spritegroup_{{.}}_turn_2;

    vehicle_curv_info(-1, 0): return spritegroup_{{.}}_turn_2;
    vehicle_curv_info(0, -1): return spritegroup_{{.}}_turn_1;


    switch_{{.}}_height;
}
{{end}}