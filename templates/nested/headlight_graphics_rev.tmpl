{{define "headlight_graphics_rev"}}{{ if not .reuse_sprites}}
    {{$plen := parseint .ttd_len}}{{$id := concat .id "_rev"}}{{$zoom := parseint .globals.zoom }}{{$len :=.ttd_len}}


    {{$hl := .has_headlights}}
    {{$tl := .has_taillights}}
    {{$tl = "1"}}

    {{ $template := concat "template_auto_" .ttd_len -}}
    {{$template = concat $template "_anim" -}}
    {{ $hlt_on_f := concat $id "_hlt_on_front" }}
    {{if $hl}}{{ altsprites8 $hlt_on_f $template $zoom }}{{end}}
    {{ $tlt_on_f := concat $id "_tlt_on_front" }}
    {{if $tl}}{{ altsprites8 $tlt_on_f $template $zoom }}{{end}}
    {{ $hlt_on_r := concat $id "_hlt_on_rear" }}
    {{if $hl}}{{ altsprites8 $hlt_on_r $template $zoom }}{{end}}
    {{ $tlt_on_r := concat $id "_tlt_on_rear" }}
    {{if $tl}}{{ altsprites8 $tlt_on_r $template $zoom }}{{end}}

    {{$template_turn := concat "template_auto_turn_1_" $len -}}
    {{$template_turn = concat $template_turn "_anim" -}}
    {{if $hl}}{{ altsprites8n $hlt_on_f $template_turn $zoom "_turn_1" }}{{end}}
    {{if $tl}}{{ altsprites8n $tlt_on_f $template_turn $zoom "_turn_1" }}{{end}}
    {{if $hl}}{{ altsprites8n $hlt_on_r $template_turn $zoom "_turn_1" }}{{end}}
    {{if $tl}}{{ altsprites8n $tlt_on_r $template_turn $zoom "_turn_1" }}{{end}}
    {{$template_turn = concat "template_auto_turn_2_" $len -}}
    {{$template_turn = concat $template_turn "_anim" -}}
    {{if $hl}}{{ altsprites8n $hlt_on_f $template_turn $zoom "_turn_2" }}{{end}}
    {{if $tl}}{{ altsprites8n $tlt_on_f $template_turn $zoom "_turn_2" }}{{end}}
    {{if $hl}}{{ altsprites8n $hlt_on_r $template_turn $zoom "_turn_2" }}{{end}}
    {{if $tl}}{{ altsprites8n $tlt_on_r $template_turn $zoom "_turn_2" }}{{end}}

    {{$template_turn = concat "template_auto_up_" .ttd_len -}}
    {{$template_turn = concat $template_turn "_anim" -}}
    {{if $hl}}{{$hill := concat $hlt_on_f "_up" }}{{ altsprites8 $hill $template_turn $zoom }}{{end}}
    {{if $tl}}{{$hill := concat $tlt_on_f "_up" }}{{ altsprites8 $hill $template_turn $zoom }}{{end}}
    {{if $hl}}{{$hill := concat $hlt_on_r "_up" }}{{ altsprites8 $hill $template_turn $zoom }}{{end}}
    {{if $tl}}{{$hill := concat $tlt_on_r "_up" }}{{ altsprites8 $hill $template_turn $zoom }}{{end}}

    {{$template_turn = concat "template_auto_down_" .ttd_len -}}
    {{$template_turn = concat $template_turn "_anim" -}}
    {{if $hl}}{{$hill := concat $hlt_on_f "_down" }}{{ altsprites8 $hill $template_turn $zoom }}{{end}}
    {{if $tl}}{{$hill := concat $tlt_on_f "_down" }}{{ altsprites8 $hill $template_turn $zoom }}{{end}}
    {{if $hl}}{{$hill := concat $hlt_on_r "_down" }}{{ altsprites8 $hill $template_turn $zoom }}{{end}}
    {{if $tl}}{{$hill := concat $tlt_on_r "_down" }}{{ altsprites8 $hill $template_turn $zoom }}{{end}}

    {{ if gt $plen 8}}
        {{if $hl}}
            {{$sections := concat $hlt_on_f "_sections" -}}
            {{$template_turn = concat "template_auto_front_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_front" }}
            {{$template_turn = concat "template_auto_mid_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_mid" }}
            {{$template_turn = concat "template_auto_rear_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_rear" }}
        {{end}}
        {{if $tl}}
            {{$sections := concat $tlt_on_f "_sections" -}}
            {{$template_turn = concat "template_auto_front_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_front" }}
            {{$template_turn = concat "template_auto_mid_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_mid" }}
            {{$template_turn = concat "template_auto_rear_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_rear" }}
        {{end}}
        {{if $hl}}
            {{$sections := concat $hlt_on_r "_sections" -}}
            {{$template_turn = concat "template_auto_front_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_front" }}
            {{$template_turn = concat "template_auto_mid_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_mid" }}
            {{$template_turn = concat "template_auto_rear_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_rear" }}
        {{end}}
        {{if $tl}}
            {{$sections := concat $tlt_on_r "_sections" -}}
            {{$template_turn = concat "template_auto_front_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_front" }}
            {{$template_turn = concat "template_auto_mid_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_mid" }}
            {{$template_turn = concat "template_auto_rear_" .ttd_len -}}{{$template_turn = concat $template_turn "_anim" -}}{{ altsprites8n $sections $template_turn $zoom "_rear" }}
        {{end}}
    {{end}}

{{end}}{{end}}