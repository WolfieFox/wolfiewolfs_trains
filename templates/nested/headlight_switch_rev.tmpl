{{ define "headlight_switch_rev" }}
    {{ $plen := parseint .ttd_len }}
    {{ $id := concat .id "_rev" }}
    {{- $type := .type }}
    {{ $basegraphics := concat $id "_curve" }}
    {{ $basespritecount:= "0" -}}
    {{if or (eq $type "dual_electric") (and (eq $type "dual_power") (eq .railtype "ELRL"))}}
        {{ $basegraphics = concat $id "_pantograph" }}
        {{ $basespritecount = "1" -}}
    {{end}}

    {{$hl := .has_headlights}}
    {{$tl := .has_taillights}}

    {{$hasrear := ""}}
    {{if or (eq $hl "R") (eq $tl "R")}}{{$hasrear = "1"}}{{end}}
    {{if or (eq $hl "B") (eq $tl "B")}}{{$hasrear = "1"}}{{end}}

    {{$hasfront := ""}}
    {{if or (eq $hl "F") (eq $tl "F")}}{{$hasfront = "1"}}{{end}}
    {{if or (eq $hl "B") (eq $tl "B")}}{{$hasfront = "1"}}{{end}}

    {{$light_count := "0"}}
    {{$f_ix := "1"}}
    {{$r_ix := "1"}}
    {{if $hasfront}}
        {{$r_ix = "2"}}
        {{$light_count = "1"}}
        {{if $hasrear}}
            {{$light_count = "2"}}
        {{end}}
    {{else if $hasrear}}
        {{$light_count = "1"}}
    {{end}}

    {{ if not .reuse_sprites}}
        {{if or (eq $hl "F") (eq $hl "B")}}
            {{ $name := concat $id "_hlt_on_front" }}
            {{if gt $plen 8}}{{template "curve_switch_long" $name }}{{else if gt $plen 4 }}{{template "curve_switch_medium" $name }}{{else}}{{template "curve_switch_short" $name }}{{end}}
        {{end}}
        {{if or (eq $tl "F") (eq $tl "B")}}
            {{ $name := concat $id "_tlt_on_front" }}
            {{if gt $plen 8}}{{template "curve_switch_long" $name }}{{else if gt $plen 4 }}{{template "curve_switch_medium" $name }}{{else}}{{template "curve_switch_short" $name }}{{end}}
        {{end}}
        {{if or (eq $hl "R") (eq $hl "B")}}
            {{ $name := concat $id "_hlt_on_rear" }}
            {{if gt $plen 8}}{{template "curve_switch_long" $name }}{{else if gt $plen 4 }}{{template "curve_switch_medium" $name }}{{else}}{{template "curve_switch_short" $name }}{{end}}
        {{end}}
        {{if or (eq $tl "R") (eq $tl "B")}}
            {{ $name := concat $id "_tlt_on_rear" }}
            {{if gt $plen 8}}{{template "curve_switch_long" $name }}{{else if gt $plen 4 }}{{template "curve_switch_medium" $name }}{{else}}{{template "curve_switch_short" $name }}{{end}}
        {{end}}
        {{if $hasfront}}
            {{$condition := "((vehicle_is_flipped ? position_in_consist_from_end : position_in_consist) < 3) ? (train_is_driving_backwards ^ vehicle_is_flipped ? 1 : 2) : 0"}}

            switch (FEAT_TRAINS, SELF, switch_{{$id}}_front_light_state, {{$condition}})
            {
            {{if or (eq $hl "F") (eq $hl "B")}}1: switch_{{$id}}_hlt_on_front_curve;{{end}}
            {{if or (eq $tl "F") (eq $tl "B")}}2: switch_{{$id}}_tlt_on_front_curve;{{end}}
            spriteset_invisible;
            }

            {{if gt $plen 8}}
                switch (FEAT_TRAINS, SELF, switch_{{$id}}_front_light_state_front, {{$condition}})
                {
                {{if or (eq $hl "F") (eq $hl "B")}}1: switch_{{$id}}_hlt_on_front_curve_front;{{end}}
                {{if or (eq $tl "F") (eq $tl "B")}}2: switch_{{$id}}_tlt_on_front_curve_front;{{end}}
                spriteset_invisible;
                }

                switch (FEAT_TRAINS, SELF, switch_{{$id}}_front_light_state_rear, {{$condition}})
                {
                {{if or (eq $hl "F") (eq $hl "B")}}1: switch_{{$id}}_hlt_on_front_curve_rear;{{end}}
                {{if or (eq $tl "F") (eq $tl "B")}}2: switch_{{$id}}_tlt_on_front_curve_rear;{{end}}
                spriteset_invisible;
                }
            {{end}}
        {{end}}

        {{if $hasrear}}
            {{$condition := "((vehicle_is_flipped ? position_in_consist : position_in_consist_from_end) < 3) ? (train_is_driving_backwards ^ vehicle_is_flipped ? 2 : 1) : 0"}}

            switch (FEAT_TRAINS, SELF, switch_{{$id}}_rear_light_state, {{$condition}})
            {
            {{if or (eq $hl "R") (eq $hl "B")}}1: switch_{{$id}}_hlt_on_rear_curve;{{end}}
            {{if or (eq $tl "R") (eq $tl "B")}}2: switch_{{$id}}_tlt_on_rear_curve;{{end}}
            spriteset_invisible;
            }

            {{if gt $plen 8}}
                switch (FEAT_TRAINS, SELF, switch_{{$id}}_rear_light_state_front, {{$condition}})
                {
                {{if or (eq $hl "R") (eq $hl "B")}}1: switch_{{$id}}_hlt_on_rear_curve_front;{{end}}
                {{if or (eq $tl "R") (eq $tl "B")}}2: switch_{{$id}}_tlt_on_rear_curve_front;{{end}}
                spriteset_invisible;
                }

                switch (FEAT_TRAINS, SELF, switch_{{$id}}_rear_light_state_rear, {{$condition}})
                {
                {{if or (eq $hl "R") (eq $hl "B")}}1: switch_{{$id}}_hlt_on_rear_curve_rear;{{end}}
                {{if or (eq $tl "R") (eq $tl "B")}}2: switch_{{$id}}_tlt_on_rear_curve_rear;{{end}}
                spriteset_invisible;
                }
            {{end}}
        {{end}}

    {{end}}

    switch(FEAT_TRAINS, SELF, switch_{{$id}}_lights, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < ({{$basespritecount}} + {{$light_count}}) ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    {{if ne $basespritecount "0"}}0..{{$basespritecount}}{{else}}0{{end}}: switch_{{$basegraphics}};
    {{if $hasfront}}{{$f_ix}} + {{$basespritecount}}: switch_{{$id}}_front_light_state;{{end}}
    {{if $hasrear}}{{$r_ix}} + {{$basespritecount}}: switch_{{$id}}_rear_light_state;{{end}}

    // This should never be executed
    return spriteset_invisible;
    }

    {{if gt $plen 8}}
        switch(FEAT_TRAINS, SELF, switch_{{$id}}_lights_front, [
        STORE_TEMP((getbits(extra_callback_info1, 8, 8) < ({{$basespritecount}} + {{$light_count}}) ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
        getbits(extra_callback_info1, 8, 8)
        ]) {
        {{if ne $basespritecount "0"}}0..{{$basespritecount}}{{else}}0{{end}}: switch_{{$basegraphics}}_front;
        {{if $hasfront}}{{$f_ix}} + {{$basespritecount}}: switch_{{$id}}_front_light_state_front;{{end}}
        {{if $hasrear}}{{$r_ix}} + {{$basespritecount}}: switch_{{$id}}_rear_light_state_front;{{end}}

        // This should never be executed
        return spriteset_invisible;
        }

        switch(FEAT_TRAINS, SELF, switch_{{$id}}_lights_rear, [
        STORE_TEMP((getbits(extra_callback_info1, 8, 8) < ({{$basespritecount}} + {{$light_count}}) ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
        getbits(extra_callback_info1, 8, 8)
        ]) {
        {{if ne $basespritecount "0"}}0..{{$basespritecount}}{{else}}0{{end}}: switch_{{$basegraphics}}_rear;
        {{if $hasfront}}{{$f_ix}} + {{$basespritecount}}: switch_{{$id}}_front_light_state_rear;{{end}}
        {{if $hasrear}}{{$r_ix}} + {{$basespritecount}}: switch_{{$id}}_rear_light_state_rear;{{end}}

        // This should never be executed
        return spriteset_invisible;
        }
    {{end}}
{{end}}