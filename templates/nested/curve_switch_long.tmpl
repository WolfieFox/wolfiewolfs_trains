{{define "curve_switch_long"}}
// Cresting hills is a special case where the full flat sprite should be used, and
// not the 3-part set
switch (FEAT_TRAINS, SELF, switch_{{.}}_crest_check_fwd, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(1) : 0) {
    0: return spriteset_{{.}}_sections_mid;
    return spriteset_{{.}};
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_height_fwd, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(-1) : 0) {
    -128..-1: return spriteset_{{.}}_down;
    1..127: return spriteset_{{.}}_up;

    // Long vehicle, use the 3-sprite layout
    switch_{{.}}_crest_check_fwd;
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve_fwd, getbits(extra_callback_info1, 0, 8) == 0 && other_veh_is_hidden(-1) != 1 ? curv_info : 0)  {
    vehicle_curv_info(1, 0): return spriteset_{{.}}_turn_1;
    vehicle_curv_info(0, 1): return spriteset_{{.}}_turn_2;

    vehicle_curv_info(-1, 0): return spriteset_{{.}}_turn_2;
    vehicle_curv_info(0, -1): return spriteset_{{.}}_turn_1;

    vehicle_curv_info(0, 0): switch_{{.}}_height_fwd;
    return spriteset_{{.}};
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_crest_check_rev, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(-1) : 0) {
    0: return spriteset_{{.}}_sections_mid;
    return spriteset_{{.}};
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_height_rev, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(1) : 0) {
    -128..-1: return spriteset_{{.}}_up;
    1..127: return spriteset_{{.}}_down;

    // Long vehicle, use the 3-sprite layout
    switch_{{.}}_crest_check_rev;
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve_rev, getbits(extra_callback_info1, 0, 8) == 0 && other_veh_is_hidden(1) != 1 ? curv_info : 0)  {
    vehicle_curv_info(-1, 0): return spriteset_{{.}}_turn_2;
    vehicle_curv_info(0, -1): return spriteset_{{.}}_turn_1;

    vehicle_curv_info(1, 0): return spriteset_{{.}}_turn_1;
    vehicle_curv_info(0, 1): return spriteset_{{.}}_turn_2;

    vehicle_curv_info(0, 0): switch_{{.}}_height_rev;
    return spriteset_{{.}};
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve, vehicle_is_flipped)  {
    0: switch_{{.}}_curve_fwd;
    1: switch_{{.}}_curve_rev;
}

// Switches for front
switch (FEAT_TRAINS, SELF, switch_{{.}}_height_front_fwd, getbits(extra_callback_info1, 0, 8) == 0 ?  abs(other_veh_z_offset(1)) + abs(other_veh_z_offset(2))  : 0) {
    0: return spriteset_{{.}}_sections_front;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve_front_fwd, getbits(extra_callback_info1, 0, 8) == 0 ? abs(other_veh_curv_info(1)) + abs(other_veh_curv_info(2)) : 0)  {
    0: switch_{{.}}_height_front_fwd;
    return spriteset_invisible;
}

// Switches for front
switch (FEAT_TRAINS, SELF, switch_{{.}}_height_front_rev, getbits(extra_callback_info1, 0, 8) == 0 ?  abs(other_veh_z_offset(-1)) + abs(other_veh_z_offset(-2))  : 0) {
    0: return spriteset_{{.}}_sections_front;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve_front_rev, getbits(extra_callback_info1, 0, 8) == 0 ? abs(other_veh_curv_info(-1)) + abs(other_veh_curv_info(-2)) : 0)  {
    0: switch_{{.}}_height_front_rev;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve_front, vehicle_is_flipped)  {
    0: switch_{{.}}_curve_front_fwd;
    1: switch_{{.}}_curve_front_rev;
}

// Switches for rear
switch (FEAT_TRAINS, SELF, switch_{{.}}_height_rear_fwd, getbits(extra_callback_info1, 0, 8) == 0 ? abs(other_veh_z_offset(-1)) + abs(other_veh_z_offset(-2)): 0) {
    0: return spriteset_{{.}}_sections_rear;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve_rear_fwd, getbits(extra_callback_info1, 0, 8) == 0 && other_veh_is_hidden(-2) != 1 ? abs(other_veh_curv_info(-1)) + abs(other_veh_curv_info(-2)) : 0)  {
    0: switch_{{.}}_height_rear_fwd;
    return spriteset_invisible;
}

// Switches for rear
switch (FEAT_TRAINS, SELF, switch_{{.}}_height_rear_rev, getbits(extra_callback_info1, 0, 8) == 0 ? abs(other_veh_z_offset(1)) + abs(other_veh_z_offset(2)): 0) {
    0: return spriteset_{{.}}_sections_rear;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve_rear_rev, getbits(extra_callback_info1, 0, 8) == 0 && other_veh_is_hidden(2) != 1 ? abs(other_veh_curv_info(1)) + abs(other_veh_curv_info(2)) : 0)  {
    0: switch_{{.}}_height_rear_rev;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve_rear, vehicle_is_flipped)  {
    0: switch_{{.}}_curve_rear_fwd;
    1: switch_{{.}}_curve_rear_rev;
}
{{end}}