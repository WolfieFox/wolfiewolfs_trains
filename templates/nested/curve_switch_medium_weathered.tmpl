{{define "curve_switch_medium_weathered"}}
switch (FEAT_TRAINS, SELF, switch_{{.}}_height_regular_fwd, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(-1) : 0) {
    -128..-1: return spriteset_{{.}}_down;
    1..127: return spriteset_{{.}}_up;
    return spriteset_{{.}};
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_height_regular_rev, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(1) : 0) {
    -128..-1: return spriteset_{{.}}_up;
    1..127: return spriteset_{{.}}_down;
    return spriteset_{{.}};
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_height_regular, vehicle_is_flipped) {
    0: switch_{{.}}_height_regular_fwd;
    1: switch_{{.}}_height_regular_rev;
}

switch (FEAT_TRAINS, SELF, switch_{{.}}_curve_regular, getbits(extra_callback_info1, 0, 8) == 0 ? curv_info : 0)  {
    vehicle_curv_info(1, 0): return spriteset_{{.}}_turn_1;
    vehicle_curv_info(0, 1): return spriteset_{{.}}_turn_2;

    vehicle_curv_info(-1, 0): return spriteset_{{.}}_turn_2;
    vehicle_curv_info(0, -1): return spriteset_{{.}}_turn_1;

    switch_{{.}}_height_regular;
}

