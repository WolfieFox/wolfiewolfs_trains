{{define "curve_switch_long_weathered_inner"}}
// {{.variant}}
// Cresting hills is a special case where the full flat sprite should be used, and
// not the 3-part set
switch (FEAT_TRAINS, SELF, switch_{{.id}}_crest_check_{{.variant}}_fwd, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(-1) : 0) {
    0: return spriteset_{{.id}}{{.innervariant}}_sections_mid;
    return spriteset_{{.id}}{{.innervariant}};
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_height_{{.variant}}_fwd, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(1) : 0) {
    -128..-1: return spriteset_{{.id}}{{.innervariant}}_down;
    1..127: return spriteset_{{.id}}{{.innervariant}}_up;

    // Long vehicle, use the 3-sprite layout
    switch_{{.id}}_crest_check_{{.variant}}_fwd;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_crest_check_{{.variant}}_rev, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(-1) : 0) {
    0: return spriteset_{{.id}}{{.innervariant}}_sections_mid;
    return spriteset_{{.id}}{{.innervariant}};
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_height_{{.variant}}_rev, getbits(extra_callback_info1, 0, 8) == 0 ? other_veh_z_offset(1) : 0) {
    -128..-1: return spriteset_{{.id}}{{.innervariant}}_up;
    1..127: return spriteset_{{.id}}{{.innervariant}}_down;

    // Long vehicle, use the 3-sprite layout
    switch_{{.id}}_crest_check_{{.variant}}_rev;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_height_{{.variant}}, vehicle_is_flipped) {
    0: switch_{{.id}}_height_{{.variant}}_fwd;
    1: switch_{{.id}}_height_{{.variant}}_rev;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_curve_{{.variant}}, getbits(extra_callback_info1, 0, 8) == 0 && other_veh_is_hidden(-1) != 1 ? curv_info : 0)  {
    vehicle_curv_info(1, 0): return spriteset_{{.id}}{{.innervariant}}_turn_1;
    vehicle_curv_info(0, 1): return spriteset_{{.id}}{{.innervariant}}_turn_2;

    vehicle_curv_info(-1, 0): return spriteset_{{.id}}{{.innervariant}}_turn_2;
    vehicle_curv_info(0, -1): return spriteset_{{.id}}{{.innervariant}}_turn_1;

    vehicle_curv_info(0, 0): switch_{{.id}}_height_{{.variant}};
    return spriteset_{{.id}}{{.innervariant}};
}

// Switches for front
switch (FEAT_TRAINS, SELF, switch_{{.id}}_height_front_{{.variant}}_fwd, getbits(extra_callback_info1, 0, 8) == 0 ?  abs(other_veh_z_offset(1)) + abs(other_veh_z_offset(2))  : 0) {
    0: return spriteset_{{.id}}{{.innervariant}}_sections_front;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_curve_front_{{.variant}}_fwd, getbits(extra_callback_info1, 0, 8) == 0 ? abs(other_veh_curv_info(1)) + abs(other_veh_curv_info(2)) : 0)  {
    0: switch_{{.id}}_height_front_{{.variant}}_fwd;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_height_front_{{.variant}}_rev, getbits(extra_callback_info1, 0, 8) == 0 ?  abs(other_veh_z_offset(-1)) + abs(other_veh_z_offset(-2))  : 0) {
    0: return spriteset_{{.id}}{{.innervariant}}_sections_front;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_curve_front_{{.variant}}_rev, getbits(extra_callback_info1, 0, 8) == 0 ? abs(other_veh_curv_info(-1)) + abs(other_veh_curv_info(-2)) : 0)  {
    0: switch_{{.id}}_height_front_{{.variant}}_rev;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_curve_front_{{.variant}}, vehicle_is_flipped)  {
    0: switch_{{.id}}_curve_front_{{.variant}}_fwd;
    1: switch_{{.id}}_curve_front_{{.variant}}_rev;
}

// Switches for rear
switch (FEAT_TRAINS, SELF, switch_{{.id}}_height_rear_{{.variant}}_fwd, getbits(extra_callback_info1, 0, 8) == 0 ? abs(other_veh_z_offset(-1)) + abs(other_veh_z_offset(-2)): 0) {
    0: return spriteset_{{.id}}{{.innervariant}}_sections_rear;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_curve_rear_{{.variant}}_fwd, getbits(extra_callback_info1, 0, 8) == 0 && other_veh_is_hidden(-2) != 1 ? abs(other_veh_curv_info(-1)) + abs(other_veh_curv_info(-2)) : 0)  {
    0: switch_{{.id}}_height_rear_{{.variant}}_fwd;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_height_rear_{{.variant}}_rev, getbits(extra_callback_info1, 0, 8) == 0 ? abs(other_veh_z_offset(1)) + abs(other_veh_z_offset(2)): 0) {
    0: return spriteset_{{.id}}{{.innervariant}}_sections_rear;
    return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_curve_rear_{{.variant}}_rev, getbits(extra_callback_info1, 0, 8) == 0 && other_veh_is_hidden(2) != 1 ? abs(other_veh_curv_info(1)) + abs(other_veh_curv_info(2)) : 0)  {
0: switch_{{.id}}_height_rear_{{.variant}}_rev;
return spriteset_invisible;
}

switch (FEAT_TRAINS, SELF, switch_{{.id}}_curve_rear_{{.variant}}, vehicle_is_flipped)  {
    0: switch_{{.id}}_curve_rear_{{.variant}}_fwd;
    1: switch_{{.id}}_curve_rear_{{.variant}}_rev;
}
{{end}}