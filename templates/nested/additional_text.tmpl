{{define "additional_text" -}}

// Slightly odd undocumented? workaround. We're using it because it avoids using up the (precious) D0XX string range.
// Instead returned values are in the DCXX string range, which is 10x bigger.
switch (FEAT_TRAINS, SELF, switch_{{.id}}_additional_text,
        [STORE_TEMP({{.additional_text_string}}, 0x100)]) {
        return 0x40F;
}
{{end}}